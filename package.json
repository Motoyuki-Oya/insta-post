{
  "name": "insta-post",
  "version": "1.0.0",
  "description": "CLI tool to publish AI generated images and videos to Instagram via Graph API with S3/R2 temporary hosting",
  "main": "dist/insta-post.cjs",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node18 --outfile=dist/insta-post.cjs --minify"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.750.0",
    "commander": "^13.1.0",
    "mime-types": "^2.1.35",
    "smol-toml": "^1.3.1"
  },
  "devDependencies": {
    "@types/mime-types": "^2.1.4",
    "@types/node": "^22.13.4",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  }
}
